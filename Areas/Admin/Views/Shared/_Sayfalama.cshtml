@model (int Sayfa, int ToplamSayfa, int ToplamKayit)
@{
    string Adres(int sayfa)
    {
        var sorgu = Context.Request.Query
            .Where(x => x.Key != "sayfa")
            .Select(x => $"{Uri.EscapeDataString(x.Key)}={Uri.EscapeDataString(x.Value.ToString())}")
            .Append($"sayfa={sayfa}");
        return Context.Request.Path + "?" + string.Join("&", sorgu);
    }
    int ilk = Math.Max(1, Model.Sayfa - 2);
    int son = Math.Min(Model.ToplamSayfa, Model.Sayfa + 2);
}
<div class="card-footer d-flex align-items-center">
    <p class="m-0 text-secondary">Toplam <strong>@Model.ToplamKayit</strong> kayıt</p>
    @if (Model.ToplamSayfa > 1)
    {
        <ul class="pagination m-0 ms-auto">
            <li class="page-item @(Model.Sayfa == 1 ? "disabled" : "")">
                <a class="page-link" href="@Adres(Model.Sayfa - 1)"><i class="ti ti-chevron-left"></i></a>
            </li>
            @for (int i = ilk; i <= son; i++)
            {
                <li class="page-item @(i == Model.Sayfa ? "active" : "")"><a class="page-link" href="@Adres(i)">@i</a></li>
            }
            <li class="page-item @(Model.Sayfa == Model.ToplamSayfa ? "disabled" : "")">
                <a class="page-link" href="@Adres(Model.Sayfa + 1)"><i class="ti ti-chevron-right"></i></a>
            </li>
        </ul>
    }
</div>
